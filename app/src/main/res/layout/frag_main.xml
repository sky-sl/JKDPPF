            app:layout_constraintHeight_percent="0.22"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_name"
                android:textColor="@color/textColor"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="10dp"
                android:text="今日称重打印总览"
                android:textColor="@color/textColor"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_total_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:text="称重重量："
                android:textColor="@color/textColor"
                android:textSize="@dimen/home_font_content2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_total" />

            <TextView
                android:id="@+id/tv_total_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@{viewModel.totalWeight + @string/unit_kg}"
                android:textColor="@color/text_content"
                android:textSize="@dimen/home_font_content2"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_total_weight"
                app:layout_constraintStart_toEndOf="@+id/tv_total_weight"
                app:layout_constraintTop_toTopOf="@+id/tv_total_weight" />

            <TextView
                android:id="@+id/tv_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="6dp"
                android:text="称重次数："
                android:textColor="@color/textColor"
                android:textSize="@dimen/home_font_content2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_total_weight" />

            <TextView
                android:id="@+id/tv_total_count_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@={viewModel.totalWeightCount}"
                android:textColor="@color/text_content"
                android:textSize="@dimen/home_font_content2"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/tv_total_count"
                app:layout_constraintStart_toEndOf="@+id/tv_total_count"
                app:layout_constraintTop_toTopOf="@+id/tv_total_count" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="45dp"
                android:background="@drawable/shape_btn_rect_corner_green"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="详情->"
                android:gravity="center"
                android:textColor="@color/text_content"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/btn_margin_parent_bottom"
                android:layout_marginEnd="12dp"
                onClickCommand="@{viewModel.onToRecordPage}"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

