                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_shelf_life_colon + viewModel.mSelectedProductBean.shelfLife}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_storage_colon + viewModel.mSelectedProductBean.storageMethod}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_eat_colon + viewModel.mSelectedProductBean.edibleMethod}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_note_colon + viewModel.mSelectedProductBean.precautions}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
            </LinearLayout>

            <TextView
                android:id="@+id/text_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/layout_product_nutrition"
                app:layout_constraintEnd_toEndOf="@+id/layout_product_nutrition"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_gravity="center_horizontal"
                android:text="@{@string/product_name_colon + viewModel.mSelectedProductBean.productName}"
                android:maxLines="1"
                android:textSize="20sp"
                android:textColor="@color/textColor"/>

            <TextView
                android:id="@+id/text_nutrition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/layout_product_nutrition"
                app:layout_constraintEnd_toEndOf="@+id/layout_product_nutrition"
                app:layout_constraintTop_toBottomOf="@+id/text_product_name"
                android:layout_gravity="center_horizontal"
                android:text="@string/product_nutrition"
                android:maxLines="1"
                android:textSize="@dimen/print_font"
                android:textColor="@color/textColor"/>

            <LinearLayout
                android:id="@+id/layout_product_nutrition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/text_nutrition"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.6"
                android:background="@drawable/label_border_black"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/project"
                        android:textSize="@dimen/print_font"
                        android:textColor="@color/textColor"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/per_100g"
                        android:textSize="@dimen/print_font"
                        android:textColor="@color/textColor"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/nrv_percent"
                        android:textSize="@dimen/print_font"
                        android:textColor="@color/textColor"/>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/textColor"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemBinding="@{viewModel.itemBindingNutrition}"
                    app:items="@{viewModel.observableListNutrition}"
                    app:layoutManager="@{LayoutManagers.linear()}"
                    app:lineManager="@{LineManagers.horizontal()}"
                    android:layout_margin="2dp"/>
            </LinearLayout>


