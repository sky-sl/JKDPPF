                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_license_colon + viewModel.mSelectedProductBean.productionLicense}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_factory_colon + viewModel.mSelectedProductBean.manufacturer}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_address_colon + viewModel.mSelectedProductBean.address}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_entrust_colon + viewModel.mSelectedProductBean.entrust}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_entrust_address_colon + viewModel.mSelectedProductBean.entrustAddress}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_origin_colon + viewModel.mSelectedProductBean.origin}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/label_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@{@string/product_phone_colon + viewModel.mSelectedProductBean.phone}"
                    android:textSize="@dimen/print_font"
                    android:textColor="@color/textColor"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/shape_home_view_corner"
            app:layout_constraintStart_toEndOf="@+id/layout_statistics"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_fjzx"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:itemBinding="@{viewModel.itemBindingProduct}"
                app:items="@{viewModel.observableListProduct}"
                app:layoutManager="@{LayoutManagers.grid(6)}"
                android:layout_marginTop="4dp"
                android:layout_marginLeft="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/view_weight"
                android:scrollbars="vertical"
                android:fadeScrollbars="false" />

            <View
                android:id="@+id/view_weight"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/shape_view_corner"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"/>

