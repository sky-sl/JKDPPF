                android:layout_height="wrap_content"
                android:text="@={viewModel.mSelectedProductBean.productName}"
                android:hint="产品名称"
                android:textSize="@dimen/home_font_title1"
                android:textColor="@color/home_main_text_color"
                app:layout_constraintStart_toStartOf="@+id/view_weight"
                app:layout_constraintTop_toTopOf="@+id/view_weight"
                android:layout_marginLeft="12dp"/>

            <TextView
                android:id="@+id/tv_trash_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="产品编号："
                android:textSize="@dimen/home_font_title2"
                android:textColor="@color/textMainTitle"
                app:layout_constraintStart_toEndOf="@+id/tv_trash_type"
                app:layout_constraintBottom_toBottomOf="@+id/tv_trash_type"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="12dp"/>

            <TextView
                android:id="@+id/tv_unit_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@={viewModel.mSelectedProductBean.productCode}"
                android:hint="--"
                android:textSize="@dimen/home_font_content"
                android:textColor="@color/textMainTitle"
                app:layout_constraintStart_toEndOf="@+id/tv_trash_price"
                app:layout_constraintTop_toTopOf="@+id/tv_trash_price"
                app:layout_constraintBottom_toBottomOf="@+id/tv_trash_price" />

            <TextView
                android:id="@+id/tv_factory_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日期："
                android:textSize="@dimen/home_font_title2"
                android:textColor="@color/home_main_text_color"
                app:layout_constraintStart_toStartOf="@+id/tv_trash_type"
                app:layout_constraintTop_toBottomOf="@+id/tv_trash_price"
                android:layout_marginTop="5dp"/>

            <LinearLayout
                android:layout_width="@dimen/edit_width"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/shape_input_rect_corner"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@+id/tv_box_tare"
                app:layout_constraintTop_toTopOf="@+id/tv_factory_name"
                android:paddingLeft="5dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="选择生产日期"
                    android:text="@={viewModel.mProductionDate}"
                    android:textColor="@color/textColor"
                    android:textColorHint="@color/textColorHint"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="@dimen/btn_edit"
                    android:layout_height="@dimen/btn_edit"
                    android:src="@mipmap/ic_edit"
                    android:foreground="?android:attr/selectableItemBackground"
                    onClickCommand="@{viewModel.onEditTagTitleClick}"
                    android:padding="5dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_box_tare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="皮重："
                android:textSize="@dimen/home_font_title2"
                android:textColor="@color/home_main_text_color"
                app:layout_constraintStart_toStartOf="@+id/tv_factory_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_factory_name"
                android:layout_marginTop="15dp"/>

            <LinearLayout
                android:id="@+id/layout_tare"
                android:layout_width="@dimen/edit_width"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/shape_input_rect_corner"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@+id/tv_box_tare"
                app:layout_constraintTop_toTopOf="@+id/tv_box_tare"
                android:paddingLeft="5dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="输入皮重"
                    android:text="@={viewModel.mTareWeight}"
                    android:textColor="@color/textColor"
                    android:textColorHint="@color/textColorHint"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="@dimen/btn_edit"
                    android:layout_height="@dimen/btn_edit"
                    android:src="@mipmap/ic_edit"
                    android:foreground="?android:attr/selectableItemBackground"
                    onClickCommand="@{viewModel.onEditTare}"
                    android:padding="5dp"/>
            </LinearLayout>



            <TextView
                android:id="@+id/tv_kj_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="打印份数："
                android:textSize="20sp"
                android:textColor="@color/home_main_text_color"
                android:layout_marginTop="25dp"
                app:layout_constraintStart_toStartOf="@+id/tv_box_tare"
                app:layout_constraintTop_toBottomOf="@+id/tv_box_tare"/>

            <RadioGroup
                android:id="@+id/radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toEndOf="@+id/tv_kj_date"
                app:layout_constraintTop_toTopOf="@+id/tv_kj_date"
                app:layout_constraintBottom_toBottomOf="@+id/tv_kj_date"
                app:onCheckedChangedCommand="@{viewModel.onRadioGroupCheckChanged}">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="true"
                    android:checked="@{viewModel.mPrintSelected == 0}"
                    android:text="不打印" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="true"
                    android:checked="@{viewModel.mPrintSelected == 1}"
                    android:text="打印1份" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="true"
                    android:checked="@{viewModel.mPrintSelected == 2}"
                    android:text="打印2份"/>
            </RadioGroup>

            <TextView
                android:id="@+id/tv_weight_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="@dimen/home_font_title1"
                android:textColor="@color/home_main_text_color"
                app:layout_constraintStart_toEndOf="@+id/tv_weight_value"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_weight_value"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="12dp"/>

            <LinearLayout
                android:id="@+id/layout_printer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:background="@drawable/shape_btn_rect_corner_red"
                app:layout_constraintTop_toTopOf="@+id/tv_trash_type"
                app:layout_constraintBottom_toBottomOf="@+id/tv_trash_type"
                app:layout_constraintEnd_toEndOf="@+id/tv_weight_name"
                android:gravity="center_vertical"
                android:foreground="?android:attr/selectableItemBackground"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/iv_printer"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@mipmap/ic_printer_off" />

                <TextView
                    android:id="@+id/tv_printer_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="未连接"
                    android:textColor="@color/btnColorRed"
                    android:textSize="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_weight_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="0.00"
                android:text="@={viewModel.productWeight}"
                android:textSize="@dimen/home_font_weight"
                android:textColor="@color/text_weight"
                app:layout_constraintStart_toStartOf="@+id/view_weight"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_weight"
                app:layout_constraintBottom_toBottomOf="@+id/view_weight"
                app:layout_constraintHorizontal_bias="0.53"
                android:layout_marginLeft="12dp"/>


            <TextView
                android:id="@+id/tv_btn_setting"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="@dimen/btn_textview_width_percent"
                app:layout_constraintHeight_percent="@dimen/btn_textview_height_percent"
                android:background="@drawable/button_background"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginRight="20dp"
                android:text="更多设置"
                android:gravity="center"
                android:textColor="@color/btn_text_normal"
                android:textSize="@dimen/font_btn_text"
                app:layout_constraintEnd_toEndOf="@+id/view_weight"
                app:layout_constraintTop_toTopOf="@+id/view_weight"
                app:layout_constraintBottom_toTopOf="@+id/tv_btn_sync"
                app:layout_constraintHorizontal_chainStyle="spread"
                android:layout_marginBottom="@dimen/btn_margin_parent_bottom"
                onClickCommand="@{viewModel.onToSettingPage}"/>

            <TextView
                android:id="@+id/tv_btn_sync"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="@dimen/btn_textview_width_percent"
                app:layout_constraintHeight_percent="@dimen/btn_textview_height_percent"
                android:background="@drawable/button_background"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginRight="20dp"
                android:text="称重记录"
                android:gravity="center"
                android:textColor="@color/btn_text_normal"
                android:textSize="@dimen/font_btn_text"
                app:layout_constraintTop_toBottomOf="@+id/tv_btn_setting"
                app:layout_constraintBottom_toTopOf="@+id/tv_btn_save"
                app:layout_constraintEnd_toEndOf="@+id/view_weight"
                android:layout_marginBottom="@dimen/btn_margin_parent_bottom"
                onClickCommand="@{viewModel.onToRecordPage}"/>

            <TextView
                android:id="@+id/tv_btn_save"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="@dimen/btn_textview_width_percent"
                app:layout_constraintHeight_percent="@dimen/btn_textview_height_percent"
                android:background="@drawable/button_background"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginRight="20dp"
                android:text="保存打印"
                android:gravity="center"
                android:textColor="@color/btn_text_normal"
                android:textSize="@dimen/font_btn_text"
                app:layout_constraintTop_toBottomOf="@+id/tv_btn_sync"
                app:layout_constraintEnd_toEndOf="@+id/view_weight"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/btn_margin_parent_bottom"
                onClickCommand="@{viewModel.onSaveAndPrint}"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>