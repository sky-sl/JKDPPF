<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 填充的颜色 -->
    <gradient
        android:angle="0"
        android:startColor="#D3F3F4"
        android:centerColor="#F7EAF1"
        android:endColor="#D3F3F4" />
    <!-- 设置按钮的四个角为弧形 -->
    <!-- android:radius 弧形的半径 -->
    <corners android:radius="5dp" />
    <!--边框的宽度及颜色-->
    <stroke android:width="4dp" android:color="#E5521C" />
</shape>